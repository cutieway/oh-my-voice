.vs/
obj/
bin/
*.user
WATCHDOG.yml
docs/advisor.md
vendors/

# oh-my-voice: reference-voice guard (Q6).
# Real-actor reference audio must NEVER be committed. It lives in
# ~/oh-my-voice-refs/ or a gitignored references/ directory.
# CI (scripts/check-refs.sh) rejects audio blobs and any references/ path.
references/
*.wav
*.ogg
*.flac
*.mp3
!Data/**/*.ogg

# TTS batch runtime: weights, caches, references, and generated packs stay
# under one gitignored root.
data/
__pycache__/
*.pyc
