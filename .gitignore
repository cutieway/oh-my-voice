# oh-my-voice: voice-audio guard (Q6).
# Raw game audio and derived embeddings must NEVER be committed. They live
# under data/ (gitignored) or ~/oh-my-voice-refs/ for isolated tests.
# CI (scripts/check-refs.sh) rejects audio/embedding blobs and references/ paths.
references/
*.wav
*.ogg
*.flac
*.mp3
!Data/**/*.ogg

# TTS batch runtime: weights, caches, references, and generated packs stay
# under one gitignored root.
data/
__pycache__/
*.pyc

# Local agent instructions; keep out of the public repository.
/AGENTS.md

# Local scratch notes.
/todo.md
/prompt.md
/temp.md

# Example blueprints are local audition material, not shipped data. The
# pipeline that will fill blueprints/characters/ does not exist yet.
/blueprints/archive/


/ffxiv_voice_casting_implementation_spec.md
/oh_my_voice_commit_4468848_review_and_jev_style_refactor_spec.md
/oh_my_voice_bfb4024_review_and_style_v3_spec.md
/a.md
