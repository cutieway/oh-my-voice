{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oh-my-voice/blueprints/schema.json",
  "title": "Qwen3-TTS voice blueprint, schema 1.2",
  "description": "Structural schema for synthetic voice profiles. Acoustic identity, speech style, classification provenance, and human approval are separate. tools/blueprint.py checks vocabulary membership, evidence, prompt rules, and lifecycle invariants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_version",
    "profile_kind",
    "character",
    "identity",
    "evidence",
    "lifecycle"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2"
    },
    "profile_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bump on every change to a selected identity value, so generated lines can be traced to the voice that produced them."
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "source_url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_]*$"
        },
        "name": {
          "type": "string"
        },
        "npc_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "race": {
          "type": [
            "string",
            "null"
          ]
        },
        "clan": {
          "type": [
            "string",
            "null"
          ]
        },
        "sex": {
          "enum": [
            "male",
            "female",
            "unknown",
            null
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ],
          "description": "Free-text role or profession, for reviewers only. It never reaches the prompt."
        },
        "source_url": {
          "type": "string",
          "description": "Wiki or reference page the profile was derived from."
        },
        "applies_to": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Speaker labels / npc keys that share this voice. Empty for a one-character profile."
        }
      }
    },
  "identity": {
   "type": "object",
   "additionalProperties": false,
   "description": "Acoustic design fields. Every field is optional: unknown facts stay null and the renderer omits them.",
   "properties": {
    "presentation": {
     "type": [
      "string",
      "null"
     ]
    },
    "perceived_age": {
     "type": [
      "string",
      "null"
     ]
    },
    "perceived_vocal_size": {
     "type": [
      "string",
      "null"
     ]
    },
    "vocal_weight": {
     "type": [
      "string",
      "null"
     ]
    },
    "pitch": {
     "type": [
      "string",
      "null"
     ]
    },
    "pitch_range": {
     "type": [
      "string",
      "null"
     ]
    },
    "timbre_primary": {
     "type": [
      "string",
      "null"
     ]
    },
    "timbre_secondary": {
     "type": [
      "string",
      "null"
     ]
    },
    "timbre_preferences": {
     "type": [
      "array",
      "null"
     ],
     "items": {
      "type": "string"
     },
     "maxItems": 2,
     "uniqueItems": true
    },
    "resonance": {
     "type": [
      "string",
      "null"
     ]
    },
    "articulation": {
     "type": [
      "string",
      "null"
     ]
    },
    "speaking_pace": {
     "type": [
      "string",
      "null"
     ]
    },
    "intonation": {
     "type": [
      "string",
      "null"
     ]
    },
        "accent": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "profile",
            "strength"
          ],
          "properties": {
            "profile": {
              "type": "string"
            },
            "strength": {
              "type": "string"
            }
          }
        },
        "distinctive_traits": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "description": "Field path -> evidence record. Every non-null identity field needs one.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level"
        ],
        "properties": {
          "level": {
            "enum": [
              "explicit",
              "supported_inference",
              "creative_selection",
              "default",
              "unknown"
            ]
          },
          "source": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "revision_id": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          },
          "field": {
            "type": "string"
          }
        }
      }
    },
    "identity_provenance": {
      "type": "object",
      "description": "Field -> structured casting provenance: rule, evidence type, rule version, prior score/strength, input facts, rationale and sources.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "rule": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_type": {
            "enum": [
              "game_fact",
              "lore_fact",
              "explicit_audio",
              "creative_selection",
              "default",
              "unknown"
            ]
          },
          "rule_version": {
            "type": "string"
          },
          "prior_score": {
            "type": "number"
          },
          "casting_strength": {
            "type": "number"
          }
        }
      }
    },
    "casting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules_version": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "qc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference_duration_ok": {
          "type": "boolean"
        },
        "reference_transcript_verified": {
          "type": "boolean"
        },
        "no_reference_leak": {
          "type": "boolean"
        },
        "identity_approved": {
          "type": "boolean"
        },
        "no_drift": {
          "type": "boolean"
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "profile_kind": {
      "enum": [
        "character",
        "archetype"
      ]
    },
    "speech_style": {
      "type": "object",
      "additionalProperties": false,
      "description": "Closed-vocabulary textual style; separate from acoustic identity, appended to the instruct by default when present.",
      "properties": {
        "register": {
          "type": [
            "string",
            "null"
          ]
        },
        "vocabulary_complexity": {
          "type": [
            "string",
            "null"
          ]
        },
        "sentence_complexity": {
          "type": [
            "string",
            "null"
          ]
        },
        "colloquialism": {
          "type": [
            "string",
            "null"
          ]
        },
        "rhetorical_style": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "speech_style_analysis": {
      "type": [
        "object",
        "null"
      ],
      "description": "Reproducible dialogue measurements and classifier interpretations; not acoustic evidence.",
      "additionalProperties": true
    },
    "classification": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "dossier_hash": {
          "type": "string"
        },
        "configuration_hash": {
          "type": "string"
        },
        "source_audit_hash": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "classification_confidence",
        "manual_override",
        "approval"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "needs_review",
            "ready_for_audition",
            "auditioned",
            "approved",
            "rejected"
          ]
        },
        "classification_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "manual_override": {
          "type": "boolean"
        },
        "approval": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "approved_by",
            "approved_at",
            "reference_sha256"
          ],
          "properties": {
            "approved_by": {
              "type": "string",
              "minLength": 1
            },
            "approved_at": {
              "type": "string",
              "minLength": 1
            },
            "reference_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "rejection_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "manual_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action",
          "timestamp"
        ],
        "properties": {
          "action": {
            "enum": [
              "edit",
              "audition",
              "approve",
              "reject",
              "reset"
            ]
          },
          "timestamp": {
            "type": "string"
          },
          "by": {
            "type": [
              "string",
              "null"
            ]
          },
          "changes": {
            "type": "object"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "archetype_metadata": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "catalog_version": {
          "type": "string"
        },
        "design_reason": {
          "type": "string"
        },
        "audition_status": {
          "enum": [
            "draft",
            "auditioned",
            "approved",
            "rejected"
          ]
        }
      }
    },
    "reference_pin": {
      "type": "object",
      "additionalProperties": false,
      "description": "The single auditioned reference clip this profile's pack is built from.",
      "required": [
        "design_seed",
        "reference_sha256",
        "ref_seconds",
        "pinned_on"
      ],
      "properties": {
        "design_seed": {
          "type": "integer"
        },
        "reference_sha256": {
          "type": "string"
        },
        "ref_seconds": {
          "type": "number"
        },
        "pinned_on": {
          "type": "string"
        },
        "reference_transcript": {
          "type": "string"
        },
        "reference_transcript_sha256": {
          "type": "string"
        },
        "design_model": {
          "type": "string"
        },
        "identity_prompt_hash": {
          "type": "string"
        },
        "style_profile_hash": {
          "type": "string"
        },
        "combined_instruct_hash": {
          "type": "string"
        },
        "casting_rules_version": {
          "type": "string"
        },
        "renderer_version": {
          "type": "string"
        }
      }
    }
  }
}
