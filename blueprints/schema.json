{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oh-my-voice/blueprints/schema.json",
  "title": "Qwen3-TTS voice blueprint",
  "description": "Structural schema for one character's synthetic voice blueprint. Value lists live in vocabulary.json; tools/blueprint.py validates enum membership, selection cardinality, acoustic-family conflicts, evidence levels, and prompt hygiene there. This schema only guarantees shape.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_version", "character", "identity", "evidence"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "profile_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bump on every change to a selected identity value, so generated lines can be traced to the voice that produced them."
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "source_url"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
        "name": {"type": "string"},
        "npc_id": {"type": ["integer", "null"]},
        "race": {"type": ["string", "null"]},
        "clan": {"type": ["string", "null"]},
        "sex": {"enum": ["male", "female", "unknown", null]},
        "lore_age": {"type": ["integer", "string", "null"]},
        "role": {"type": ["string", "null"], "description": "Free-text role or profession, for reviewers only. It never reaches the prompt."},
        "source_url": {"type": "string", "description": "Wiki or reference page the profile was derived from."},
        "applies_to": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Speaker labels / npc keys that share this voice. Empty for a one-character profile."
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presentation", "pitch", "timbre_primary", "articulation", "speaking_pace", "intonation"],
      "properties": {
        "presentation": {"type": "string"},
        "perceived_age": {"type": ["string", "null"]},
        "pitch": {"type": "string"},
        "pitch_range": {"type": ["string", "null"]},
        "timbre_primary": {"type": "string"},
        "timbre_secondary": {"type": ["string", "null"]},
        "resonance": {"type": ["string", "null"]},
        "articulation": {"type": "string"},
        "speaking_pace": {"type": "string"},
        "intonation": {"type": "string"},
        "accent": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["profile", "strength"],
          "properties": {
            "profile": {"type": "string"},
            "strength": {"type": "string"}
          }
        },
        "distinctive_traits": {
          "type": "array",
          "items": {"type": "string"},
          "maxItems": 2,
          "uniqueItems": true
        }
      }
    },
    "archon_pin": {
      "type": "object",
      "description": "The pinned take per archon. The design seed fixes the reference clip, and the frozen reference fixes the voice for every dialogue line of that character.",
      "propertyNames": {"enum": ["neutral", "calm", "happy", "sad", "angry", "fearful", "secretive"]},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["design_seed", "reference_sha256"],
        "properties": {
          "design_seed": {"type": "integer", "description": "VoiceDesign seed that produced the reference clip."},
          "reference_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Hash of the reference WAV, so a regenerated take is provably the same one."},
          "ref_seconds": {"type": "number"},
          "ref_f0": {"type": "number"},
          "pinned_on": {"type": "string"}
        }
      }
    },
    "pack_archon": {
      "type": "string",
      "default": "neutral",
      "description": "The one archon this character's pack uses for every line. A casting decision, not a per-line choice."
    },
    "moods": {
      "type": "object",
      "description": "Optional extra archons. Each key is a preset plus at most two overrides. Rendered and auditioned; at most one is chosen as pack_archon.",
      "propertyNames": {"enum": ["neutral", "calm", "happy", "sad", "angry", "fearful", "secretive"]},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "intensity": {"enum": ["subtle", "mild", "moderate", "strong", "extreme"]},
          "energy": {"enum": ["very_low", "low", "moderate", "high", "very_high"]},
          "projection": {"enum": ["very_soft", "soft", "conversational", "projected", "forceful", "shouting", "whispering"]},
          "pace": {"enum": ["very_slow", "slow", "measured", "normal", "brisk", "fast", "rushed"]},
          "pitch_movement": {"enum": ["restrained", "natural", "expressive", "wide", "unstable", "rising", "falling"]},
          "articulation": {"enum": ["softened", "crisp", "firm", "clipped", "deliberate", "slurred", "breathy", "strained", "hesitant", "fluid"]},
          "rhythm": {"enum": ["even", "measured", "conversational", "erratic", "hesitant", "staccato", "flowing", "dramatic"]}
        }
      }
    },
    "evidence": {
      "type": "object",
      "description": "Field path -> evidence record. Every non-null identity field needs one.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level"],
        "properties": {
          "level": {"enum": ["explicit", "supported_inference", "creative_selection", "default", "unknown"]},
          "source": {"type": "string"},
          "quote": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    },
    "qc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference_duration_ok": {"type": "boolean"},
        "reference_transcript_verified": {"type": "boolean"},
        "no_reference_leak": {"type": "boolean"},
        "identity_approved": {"type": "boolean"},
        "no_drift": {"type": "boolean"}
      }
    },
    "notes": {"type": "string"}
  }
}
